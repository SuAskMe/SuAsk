# ---------------------------------------------------------------
# SuAsk 配置模板（脱敏）
#
# 真实配置文件 config.yaml 已被 .gitignore 忽略，不进入仓库。
# 首次部署时请在服务器上手动创建 manifest/config/config.yaml，
# 参考本文件填写，所有标记为 CHANGE_ME_ 的值必须替换。
#
# 部署推荐：
#   - 文件权限收紧到 600，属主为运行进程的用户
#   - systemd 不要再通过 --gf.gcfg.file 指定其他路径，让 GoFrame
#     自动从 manifest/config/config.yaml 加载
# ---------------------------------------------------------------

server:
    address: ":8080"
    # 单次请求体大小上限（字节），必须 >= upload.max_bytes，否则大文件会在 HTTP 层就被截掉
    clientMaxBodySize: 33554432            # 32 MiB

logger:
    path: "./logs"                         # 生产环境建议改为 /var/log/suask
    file: "{Y-m-d}.log"
    level: "info"
    timeFormat: "2006-01-02T15:04:05"
    ctxKeys: ["CtxId", "CtxName", "CtxRole"]
    stdout: true

# 数据库：SQLite，路径相对于启动时的工作目录
database:
    default:
        type: "sqlite"
        link: "sqlite::@file(./database/suask.db)"
        # 生产环境建议改为绝对路径，避免 systemd WorkingDirectory 差异导致打开空库：
        # link: "sqlite::@file(/home/suask/test-backend/database/suask.db)"

upload:
    path: "upload"                         # 上传文件落盘相对路径
    prefix: "https://your.domain"          # 对外访问图片 URL 的前缀
    max_minutes: 10                        # 每分钟每用户最大上传次数
    max_bytes: 33554432                    # 单次上传大小上限（字节），默认 32 MiB
                                           # 调大此项时记得同步调整 server.clientMaxBodySize
    allowed_mimes:                         # 允许的 MIME 白名单（魔术字节嗅探），留空用默认值
        - image/jpeg
        - image/png
        - image/gif
        - image/webp

jwt:
    signKey: "CHANGE_ME_使用_openssl_rand_-hex_32_生成"
    expire: 14                             # token 过期天数（Redis TTL），JWT 签发时额外 +1 天作为缓冲

email:
    host: "smtpdm.aliyun.com"
    port: 465
    username: "mail@your.domain"
    password: "CHANGE_ME_SMTP_PASSWORD"
    # 模板文件路径建议用绝对路径，避免 CWD 差异
    messageTmpl: "./manifest/config/msg.tmpl"
    authCodeTmpl: "./manifest/config/auth_code.tmpl"

# Redis：登录态、验证码缓存
redis:
    default:
        address: "127.0.0.1:6379"
        # password: "CHANGE_ME_如果有"
        # db: 0

# HTTPS 证书（启用 HTTPS 时使用，可选）
# https:
#     cert: "/etc/ssl/private/suask.crt"
#     key:  "/etc/ssl/private/suask.key"
